# Full test stack credentials — copy to full-test.env and fill in.
# full-test.env is gitignored. Never commit real credentials.

# ── Usenet (NNTP) provider ────────────────────────────────────────────────────
# Configured automatically in nzbdav-rs on first `just functional-test-full`.
# Safe to leave blank if you only want to test stack health without downloading.
NNTP_HOST=
NNTP_PORT=563
NNTP_USER=
NNTP_PASS=
NNTP_CONNECTIONS=4

# ── NZB indexer (Newznab-compatible) ─────────────────────────────────────────
# Configured automatically in NZBHydra2 on first `just functional-test-full`.
INDEXER_URL=
INDEXER_API_KEY=
