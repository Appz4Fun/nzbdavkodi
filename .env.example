# Required for `just extreme-functional-test` (and the existing functional-test recipes).
# Copy this file to .env (which is gitignored) and fill in real values, OR
# point EXTREME_ENV_FILE at an existing .env elsewhere on disk.

# NZBHydra2 instance (LAN or local)
HYDRA_URL=http://192.168.1.93:5076
HYDRA_API_KEY=

# Live LAN nzbdav instance (SAB-compatible API + WebDAV) and its real API
# key. The extreme harness does not containerise nzbdav; the fault proxy
# wraps this upstream, which must already have its NNTP provider
# configured server-side.
NZBDAV_URL=http://192.168.1.93:3000
NZBDAV_API_KEY=

# Eweka (or other NNTP provider) credentials. Not used by the extreme
# harness (see NZBDAV_URL above); needed by the other functional/live
# recipes.
NNTP_HOST=news.eweka.nl
NNTP_USE_SSL=false
NNTP_PORT=119
NNTP_USER=
NNTP_PASS=
NNTP_CONNS=50

# WebDAV credentials of the live nzbdav (also fed to the addon)
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=

# TMDB API key (TMDBHelper requires this for movie lookup)
TMDB_API_KEY=

# Optional: deterministic seed. Defaults to int(time.time()) per run.
# EXTREME_SEED=42

# Optional: bound assertions. Unset = pure measurement mode.
# EXTREME_MAX_RESUME_SECONDS=30
# EXTREME_MAX_FREEZE_SECONDS=10

# Optional: alternate env file location. Defaults to ./.env (see EXTREME_ENV_FILE
# in the just recipe). Use this if your real .env lives elsewhere on disk.
# EXTREME_ENV_FILE=/Users/allen/nzbdav-real-e2e/.env
